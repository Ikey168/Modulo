[Desktop Entry]
Version=1.0
Type=Application
Name=Firefox — Main
Comment=Primary browser profile for ordinary browsing
Exec=@HOME@/.local/bin/firefox-profile Main %u
Icon=firefox
Terminal=false
Categories=Network;WebBrowser;
MimeType=text/html;text/xml;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
StartupNotify=true
StartupWMClass=firefox
