{
  "manifestVersion": 2,
  "id": "org.modulo.security-audit",
  "version": "1.1.0",
  "name": "Security Audit",
  "minIrVersion": 1,
  "minCatalogVersion": "1.0.0",
  "contributes": {},
  "capabilities": [
    "approval:request",
    "blueprints:write",
    "dashboard:configure",
    "notes:write",
    "permissions:request",
    "properties:schema",
    "queries:write",
    "templates:write",
    "workspace:configure"
  ],
  "policies": {
    "upgrade": "preserve-user-content",
    "removal": "preserve-user-content",
    "demoData": "opt-in"
  },
  "resources": [
    {
      "id": "record-schema",
      "kind": "propertySchema",
      "title": "Record properties",
      "spec": {
        "fields": [
          {
            "id": "status",
            "title": "Status",
            "type": "select",
            "options": [
              "Open",
              "In review",
              "Closed"
            ]
          },
          {
            "id": "owner",
            "title": "Owner",
            "type": "text"
          },
          {
            "id": "severity",
            "title": "Severity",
            "type": "select",
            "options": [
              "Low",
              "Medium",
              "High",
              "Critical"
            ]
          },
          {
            "id": "record-kind",
            "title": "Record kind",
            "type": "select",
            "options": [
              "engagement",
              "checklist",
              "finding",
              "knowledge",
              "report"
            ]
          },
          {
            "id": "engagement",
            "title": "Engagement",
            "type": "text"
          },
          {
            "id": "evidence",
            "title": "Evidence note",
            "type": "relation"
          }
        ]
      },
      "requires": [],
      "capabilities": [
        "properties:schema"
      ]
    },
    {
      "id": "record-template",
      "kind": "template",
      "title": "Finding template",
      "spec": {
        "title": "New record",
        "markdown": "# Finding\n\n## Evidence\n\n## Recommendation\n",
        "schemaRef": "record-schema"
      },
      "requires": [
        "record-schema"
      ],
      "capabilities": [
        "templates:write"
      ]
    },
    {
      "id": "open-records",
      "kind": "savedQuery",
      "title": "Open findings",
      "spec": {
        "schemaRef": "record-schema",
        "filters": [
          {
            "property": "status",
            "operator": "eq",
            "value": "Open"
          },
          {
            "property": "record-kind",
            "operator": "eq",
            "value": "finding"
          }
        ]
      },
      "requires": [
        "record-schema"
      ],
      "capabilities": [
        "queries:write"
      ]
    },
    {
      "id": "records-table",
      "kind": "view",
      "title": "Findings",
      "spec": {
        "queryRef": "open-records",
        "layout": "table"
      },
      "requires": [
        "open-records"
      ],
      "capabilities": [
        "workspace:configure"
      ]
    },
    {
      "id": "records-board",
      "kind": "view",
      "title": "Finding status board",
      "spec": {
        "queryRef": "open-records",
        "layout": "board",
        "groupBy": "status"
      },
      "requires": [
        "open-records"
      ],
      "capabilities": [
        "workspace:configure"
      ]
    },
    {
      "id": "overview",
      "kind": "dashboard",
      "title": "Overview",
      "spec": {
        "viewRefs": [
          "records-table",
          "records-board"
        ]
      },
      "requires": [
        "records-table",
        "records-board"
      ],
      "capabilities": [
        "dashboard:configure"
      ]
    },
    {
      "id": "workspace",
      "kind": "workspaceMode",
      "title": "Security Audit",
      "spec": {
        "viewRefs": [
          "records-table",
          "records-board",
          "engagement-view",
          "checklist-view",
          "knowledge-view",
          "report-view"
        ],
        "dashboardRef": "overview",
        "builtinPlugins": [
          "notes-editor",
          "findings-tracker",
          "kanban",
          "audit-checklists",
          "vuln-kb",
          "audit-reports"
        ]
      },
      "requires": [
        "records-table",
        "records-board",
        "overview",
        "engagement-view",
        "checklist-view",
        "knowledge-view",
        "report-view"
      ],
      "capabilities": [
        "workspace:configure"
      ]
    },
    {
      "id": "demo",
      "kind": "demoData",
      "title": "Optional demo records",
      "spec": {
        "templateRef": "record-template",
        "notes": [
          {
            "id": "sample",
            "title": "Example finding",
            "markdown": "Demo content. Replace with your own evidence."
          }
        ]
      },
      "requires": [
        "record-template"
      ],
      "capabilities": [
        "notes:write"
      ]
    },
    {
      "id": "review",
      "kind": "blueprint",
      "title": "Report approval",
      "spec": {
        "ir": {
          "irVersion": 1,
          "metadata": {
            "name": "Audit report approval",
            "description": "Submit a report explicitly. A different reviewer approves its exact evidence digest.",
            "createdAt": "2026-09-05T00:00:00.000Z",
            "updatedAt": "2026-09-05T00:00:00.000Z"
          },
          "nodes": [
            {
              "id": "manual-review",
              "type": "trigger.manual",
              "nodeVersion": 1
            },
            {
              "id": "report-approval",
              "type": "action.approval.request",
              "nodeVersion": 1,
              "config": {
                "approverUserId": "2",
                "expirySeconds": 86400,
                "message": "Review the attached audit report. Approval binds this exact report version."
              }
            },
            {
              "id": "wait",
              "type": "logic.approval.wait",
              "nodeVersion": 1
            },
            {
              "id": "result",
              "type": "logic.approval.result",
              "nodeVersion": 1
            }
          ],
          "edges": [
            {
              "id": "edge-1",
              "kind": "exec",
              "fromNode": "manual-review",
              "fromPin": "then",
              "toNode": "report-approval",
              "toPin": "in"
            },
            {
              "id": "edge-2",
              "kind": "exec",
              "fromNode": "report-approval",
              "fromPin": "then",
              "toNode": "wait",
              "toPin": "in"
            },
            {
              "id": "edge-3",
              "kind": "exec",
              "fromNode": "wait",
              "fromPin": "then",
              "toNode": "result",
              "toPin": "in"
            },
            {
              "id": "edge-4",
              "kind": "data",
              "fromNode": "manual-review",
              "fromPin": "note",
              "toNode": "report-approval",
              "toPin": "context"
            },
            {
              "id": "edge-5",
              "kind": "data",
              "fromNode": "report-approval",
              "fromPin": "request",
              "toNode": "wait",
              "toPin": "request"
            },
            {
              "id": "edge-6",
              "kind": "data",
              "fromNode": "wait",
              "fromPin": "request",
              "toNode": "result",
              "toPin": "request"
            }
          ]
        }
      },
      "requires": [],
      "capabilities": [
        "blueprints:write",
        "approval:request"
      ]
    },
    {
      "id": "review-consent",
      "kind": "permissionPreset",
      "title": "Review consent",
      "spec": {
        "requested": [
          "approval:request"
        ]
      },
      "requires": [
        "review"
      ],
      "capabilities": [
        "permissions:request",
        "approval:request"
      ]
    },
    {
      "id": "engagement-template",
      "kind": "template",
      "title": "Engagement intake",
      "requires": [
        "record-schema"
      ],
      "capabilities": [
        "templates:write"
      ],
      "spec": {
        "title": "Engagement intake",
        "schemaRef": "record-schema",
        "markdown": "# Scope\n\n## Assets\n\n## Constraints\n"
      }
    },
    {
      "id": "engagement-records",
      "kind": "savedQuery",
      "title": "Engagement intake",
      "requires": [
        "record-schema"
      ],
      "capabilities": [
        "queries:write"
      ],
      "spec": {
        "schemaRef": "record-schema",
        "filters": [
          {
            "property": "record-kind",
            "operator": "eq",
            "value": "engagement"
          }
        ]
      }
    },
    {
      "id": "engagement-view",
      "kind": "view",
      "title": "Engagement intake",
      "requires": [
        "engagement-records"
      ],
      "capabilities": [
        "workspace:configure"
      ],
      "spec": {
        "queryRef": "engagement-records",
        "layout": "table"
      }
    },
    {
      "id": "checklist-template",
      "kind": "template",
      "title": "Audit checklist",
      "requires": [
        "record-schema"
      ],
      "capabilities": [
        "templates:write"
      ],
      "spec": {
        "title": "Audit checklist",
        "schemaRef": "record-schema",
        "markdown": "# Audit checklist\n\n- [ ] Confirm scope\n- [ ] Review access control\n- [ ] Validate findings and evidence\n- [ ] Review final report\n"
      }
    },
    {
      "id": "checklist-records",
      "kind": "savedQuery",
      "title": "Audit checklist",
      "requires": [
        "record-schema"
      ],
      "capabilities": [
        "queries:write"
      ],
      "spec": {
        "schemaRef": "record-schema",
        "filters": [
          {
            "property": "record-kind",
            "operator": "eq",
            "value": "checklist"
          }
        ]
      }
    },
    {
      "id": "checklist-view",
      "kind": "view",
      "title": "Audit checklist",
      "requires": [
        "checklist-records"
      ],
      "capabilities": [
        "workspace:configure"
      ],
      "spec": {
        "queryRef": "checklist-records",
        "layout": "table"
      }
    },
    {
      "id": "knowledge-template",
      "kind": "template",
      "title": "Vulnerability knowledge",
      "requires": [
        "record-schema"
      ],
      "capabilities": [
        "templates:write"
      ],
      "spec": {
        "title": "Vulnerability knowledge",
        "schemaRef": "record-schema",
        "markdown": "# Vulnerability knowledge\n\n## References\n\n## Recommendation\n"
      }
    },
    {
      "id": "knowledge-records",
      "kind": "savedQuery",
      "title": "Vulnerability knowledge",
      "requires": [
        "record-schema"
      ],
      "capabilities": [
        "queries:write"
      ],
      "spec": {
        "schemaRef": "record-schema",
        "filters": [
          {
            "property": "record-kind",
            "operator": "eq",
            "value": "knowledge"
          }
        ]
      }
    },
    {
      "id": "knowledge-view",
      "kind": "view",
      "title": "Vulnerability knowledge",
      "requires": [
        "knowledge-records"
      ],
      "capabilities": [
        "workspace:configure"
      ],
      "spec": {
        "queryRef": "knowledge-records",
        "layout": "table"
      }
    },
    {
      "id": "report-template",
      "kind": "template",
      "title": "Audit report",
      "requires": [
        "record-schema"
      ],
      "capabilities": [
        "templates:write"
      ],
      "spec": {
        "title": "Audit report",
        "schemaRef": "record-schema",
        "markdown": "# Audit report\n\n## Scope\n\n## Findings\n\n## Reviewer decision\n"
      }
    },
    {
      "id": "report-records",
      "kind": "savedQuery",
      "title": "Audit report",
      "requires": [
        "record-schema"
      ],
      "capabilities": [
        "queries:write"
      ],
      "spec": {
        "schemaRef": "record-schema",
        "filters": [
          {
            "property": "record-kind",
            "operator": "eq",
            "value": "report"
          }
        ]
      }
    },
    {
      "id": "report-view",
      "kind": "view",
      "title": "Audit report",
      "requires": [
        "report-records"
      ],
      "capabilities": [
        "workspace:configure"
      ],
      "spec": {
        "queryRef": "report-records",
        "layout": "table"
      }
    }
  ],
  "description": "Engagement intake, checklists, findings, vulnerability knowledge, manual report review and verifiable exports."
}
