{
  "mcpServers": {
    "postgres": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://postgres_dev:postgres_dev@localhost:5432/modulodb_dev"
      ],
      "env": {}
    },
    "docker": {
      "type": "stdio",
      "command": "python3",
      "args": ["tools/docker_mcp/server.py"],
      "env": {}
    },
    "modulo": {
      "type": "stdio",
      "command": "python3",
      "args": ["tools/modulo_mcp/server.py"],
      "env": {}
    }
  }
}
