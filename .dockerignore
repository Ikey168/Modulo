# Version control
.git
.gitignore

# Node.js
frontend/node_modules
frontend/dist
frontend/.npm
frontend/coverage

# Maven
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# IDE
.idea/
*.iml
.vscode/
.settings/
.project
.classpath

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db
# Root-context frontend builds must not include local credentials or dependencies.
**/node_modules
**/target
**/dist
**/.env
**/.env.*
!**/.env.example
**/test-results
**/playwright-report
**/coverage
.agents
**/*.env
**/.releases
