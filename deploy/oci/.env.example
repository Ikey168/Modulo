# For initial IP-only validation use:
#   MODULO_SITE=http://SERVER_IP
#   MODULO_URL=http://SERVER_IP
# For production use a DNS name pointing at the VM:
#   MODULO_SITE=modulo.example.com
#   MODULO_URL=https://modulo.example.com
MODULO_SITE=
MODULO_URL=
# Absolute source checkout on the server. The relative default works locally.
NOESIS_CONTEXT=/srv/noesis

POSTGRES_DB=modulodb
POSTGRES_USER=modulo
POSTGRES_PASSWORD=
KEYCLOAK_DB_PASSWORD=
NEO4J_PASSWORD=

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=

MODULO_SECURITY_JWT_SECRET=
MODULO_SECURITY_API_KEY=
MODULO_SECURITY_ENCRYPTION_KEY=

NOESIS_JWT_SECRET=
NOESIS_API_KEY_SALT=

# Optional external blockchain RPC.
# BLOCKCHAIN_RPC_URL=https://mainnet.base.org
# BLOCKCHAIN_NETWORK=base
