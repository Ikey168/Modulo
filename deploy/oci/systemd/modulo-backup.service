[Unit]
Description=Verified local backup of Modulo and Noesis
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/srv/modulo/deploy/oci
ExecStart=/srv/modulo/deploy/oci/backup.sh --local-only
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=multi-user.target
