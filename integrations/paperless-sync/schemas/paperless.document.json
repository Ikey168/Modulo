{
  "type": "object",
  "required": ["paperlessId", "classification", "sensitivity", "restrictedStub", "status", "deleted", "retentionClass", "retentionUntil", "retentionReason", "expiryDate", "sourceVersion", "paraLinks", "review"],
  "additionalProperties": false,
  "properties": {
    "paperlessId": {"type": "integer", "minimum": 1},
    "classification": {"type": "string", "maxLength": 256},
    "sensitivity": {"enum": ["normal", "confidential", "restricted"]},
    "restrictedStub": {"type": "boolean"},
    "status": {"type": "string", "maxLength": 64},
    "deleted": {"type": "boolean"},
    "retentionClass": {"type": "string", "maxLength": 128},
    "retentionUntil": {"type": "string", "maxLength": 32},
    "retentionReason": {"type": "string", "maxLength": 512},
    "expiryDate": {"type": "string", "maxLength": 32},
    "sourceVersion": {"type": "string", "maxLength": 64},
    "title": {"type": "string", "maxLength": 512},
    "correspondent": {"type": "string", "maxLength": 256},
    "tags": {"type": "array", "maxItems": 100, "items": {"type": "string", "maxLength": 128}},
    "tagIds": {"type": "array", "maxItems": 100, "items": {"type": "integer", "minimum": 1}},
    "documentDate": {"type": "string", "maxLength": 32},
    "year": {"type": "integer", "minimum": 0, "maximum": 9999},
    "checksum": {"type": "string", "maxLength": 128},
    "storagePath": {"type": "string", "maxLength": 256},
    "business": {"type": "object", "additionalProperties": false, "required": ["invoiceDirection", "eInvoiceStatus", "evidenceType"], "properties": {"invoiceDirection": {"type": "string", "maxLength": 32}, "eInvoiceStatus": {"type": "string", "maxLength": 64}, "evidenceType": {"type": "string", "maxLength": 128}}},
    "paraLinks": {"type": "object", "additionalProperties": false, "required": ["projects", "areas", "tasks"], "properties": {"projects": {"type": "array", "maxItems": 100, "items": {"type": "string", "maxLength": 128}}, "areas": {"type": "array", "maxItems": 100, "items": {"type": "string", "maxLength": 128}}, "tasks": {"type": "array", "maxItems": 100, "items": {"type": "string", "maxLength": 128}}}},
    "review": {"type": "object", "additionalProperties": false, "required": ["status", "updatedAt"], "properties": {"status": {"type": "string", "maxLength": 64}, "updatedAt": {"type": "string", "maxLength": 64}}}
  }
}

